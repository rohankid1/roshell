import QmlProject

Project {
    /* 1. Tell Qt Creator where your custom components/folders live */
    importPaths: [ ".", "src" ]

    /* 2. Explicitly point Qt Creator to Quickshell's system QML module */
    /* Adjust this path depending on your Linux distribution (see below) */
    environmentVariables: [
        "QML_IMPORT_PATH=/usr/lib/qt6/qml"
    ]

    /* 3. Include all QML and JS files in the project sidebar */
    Files {
        filter: "*.qml"
        directory: "."
    }
    Files {
        filter: "*.js"
        directory: "."
    }
}
